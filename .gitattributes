# GitHub Linguist overrides
# Hide generated platform scaffolding from language statistics while keeping
# the hand-maintained native camera bridge and registration code detectable.

android/**        linguist-vendored=true
ios/**            linguist-vendored=true
linux/**          linguist-vendored=true
macos/**          linguist-vendored=true
web/**            linguist-vendored=true
windows/**        linguist-vendored=true

android/app/src/main/kotlin/** linguist-vendored=false
ios/Runner/*.swift            linguist-vendored=false
ios/RunnerTests/*.swift       linguist-vendored=false

# Explicitly surface application and backend code.
*.dart            linguist-detectable=true
*.py              linguist-detectable=true
